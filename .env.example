# Optional deployment overrides for the built-in public configuration.
# Only public frontend configuration belongs here. Never use a Supabase secret
# key, service_role key, database password, or personal access token.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional ODPT frontend token. Values prefixed VITE_ are visible to every visitor.
# Leave blank to use the dedicated D-TIS token. No per-browser setup is required.
VITE_ODPT_API_TOKEN=
VITE_ODPT_API_BASE_URL=https://api.odpt.org/api/v4
VITE_GTFS_URLS=

# Optional root path for local builds. GitHub Actions supplies this automatically.
# Use / for a custom domain or user.github.io repository, /D-TIS/ for project Pages.
PAGES_BASE=/
